# Copy to .env and fill in locally. .env is gitignored, vercelignored and blocked by the pre-commit hook.

# Forecasting. NOT needed for the default setup: TimesFM-3 runs locally with no key.
# Only used if we switch to Google Cloud (BigQuery AI.FORECAST or Vertex AI).
GOOGLE_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ERCOT Public API (optional, not needed for the build)
ERCOT_API_USERNAME=
ERCOT_API_PASSWORD=
ERCOT_PUBLIC_API_SUBSCRIPTION_KEY=
