{
  "name": "fleet-sim-web",
  "private": true,
  "version": "0.1.0",
  "description": "Public website for fleet-sim: 20,000 simulated home batteries trading on real ERCOT prices.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "VITE_API_BASE_URL=http://localhost:8000 vite",
    "mock": "node mock/server.ts",
    "build": "tsc -b && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "ws": "^8.21.3"
  }
}
