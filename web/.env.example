# The website reads exactly one setting, at BUILD time (Vite bakes it into the bundle).
# It is not a secret: it is the public backend URL the browser talks to.
#
#   Cloud Run:      VITE_API_BASE_URL=https://fleet-sim-XXXXXXXX.us-east1.run.app
#   Local backend:  VITE_API_BASE_URL=http://localhost:8000
#   Mock server:    VITE_API_BASE_URL=http://localhost:8787   (npm run mock)
#
# Leave it unset for `npm run dev`: the dev server then serves the simulated mock API at /__mock.
# Production builds without it show a "not connected" notice, and Vercel builds fail on purpose.
VITE_API_BASE_URL=
